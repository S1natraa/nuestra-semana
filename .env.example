# Copia este archivo como `.env.local` y rellena los valores de tu proyecto de Supabase
# (botón "Connect" del proyecto, o Project Settings → API Keys). Si estas variables están
# vacías, la app arranca en MODO DEMO con una base Postgres local en el navegador (PGlite).

# "Project URL": https://<tu-proyecto>.supabase.co
VITE_SUPABASE_URL=
# Clave pública del proyecto: "Publishable key" (sb_publishable_...) o la "anon key" clásica.
# Nunca pongas aquí la secret key, la service_role ni la contraseña de la base de datos
# (la compilación se detiene si detecta una clave secreta).
VITE_SUPABASE_PUBLISHABLE_KEY=
